# Tous les chemins relatifs sont résolus depuis le dossier de lancement.
FILM_DATA_DIR=.data
FILM_MODEL_CACHE_DIR=.models
FILM_MODEL_NAME=small
# Modèle CTranslate2 préinstallé : décommenter avec un chemin existant.
# FILM_MODEL_PATH=C:/modeles/faster-whisper-small
FILM_DEVICE=cpu
FILM_COMPUTE_TYPE=int8
FILM_CPU_THREADS=4
FILM_MAX_UPLOAD_BYTES=500000000
FILM_MAX_SCENE_SECONDS=600
FILM_MAX_JOBS=20
FILM_MAX_WORKERS=1
FILM_PROCESS_TIMEOUT_SECONDS=180
FILM_FFMPEG_BIN=ffmpeg
FILM_FFPROBE_BIN=ffprobe
# FFmpeg portable sous Windows, si les exécutables ne sont pas dans le PATH :
# FILM_FFMPEG_BIN=.tools/ffmpeg/bin/ffmpeg.exe
# FILM_FFPROBE_BIN=.tools/ffmpeg/bin/ffprobe.exe
FILM_BEAM_SIZE=5
